---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { contentLang } from '../i18n/locales';
import DownloadButtons from './DownloadButtons.astro';
import StoreButtons from './StoreButtons.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const imageDir = `/assets/images/features/${contentLang(lang)}`;

// The clip captures the English app; a translated page falls back to its own
// localized box screenshot rather than showing English UI.
const cleanupClip = lang === 'en' ? '/assets/video/collection-cleanup.mp4' : null;
---

<main class="overflow-hidden">
  <section class="relative pt-36 pb-24">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_70%_30%,rgba(3,147,218,0.16),transparent_45%)]" aria-hidden="true"></div>
    <div class="container relative mx-auto px-6 grid lg:grid-cols-[1.15fr_0.85fr] items-center gap-16">
      <div class="max-w-3xl text-center lg:text-left">
        <p class="inline-block mb-6 rounded-full border border-brand-accent/25 bg-brand-accent/10 px-4 py-2 text-xs font-black uppercase tracking-[0.2em] text-brand-accent">
          {t('cleanup.eyebrow')}
        </p>
        <h1 class="leading-[0.92] text-glow">
          <span class="block text-5xl sm:text-6xl lg:text-7xl">{t('cleanup.meta_title')}</span>
          <span class="block mt-5 text-2xl sm:text-3xl lg:text-4xl gradient-text italic">{t('cleanup.hero_title')}</span>
        </h1>
        <p class="mt-8 text-lg sm:text-xl leading-relaxed text-gray-300">
          {t('cleanup.hero_subtitle')}
        </p>
        <div class="mt-9">
          <StoreButtons placement="cleanup-hero" align="lg-start" trackImpression />
        </div>
      </div>

      <div class="relative mx-auto w-full max-w-[330px]">
        <div class="absolute -inset-8 rounded-full bg-brand-blue/20 blur-3xl" aria-hidden="true"></div>
        <div class={`relative ${cleanupClip ? 'aspect-[540/1168]' : 'aspect-[9/19.5]'} overflow-hidden rounded-[3rem] border-8 border-brand-dark/70 glass card-shadow`}>
          {cleanupClip ? (
            <video data-lazy-src={cleanupClip} poster="/assets/video/collection-cleanup-poster.webp" width="540" height="1168" class="h-full w-full object-cover" aria-label={t('cleanup.screenshot_alt')} muted loop playsinline preload="none"></video>
          ) : (
            <img src={`${imageDir}/collection.webp`} alt={t('cleanup.screenshot_alt')} width="330" height="715" class="h-full w-full object-cover" loading="eager" fetchpriority="high" decoding="async" />
          )}
        </div>
      </div>
    </div>
  </section>
</main>

<DownloadButtons placement="cleanup-footer" trackImpression />

<script>
  import { initLazyClips } from '../lib/lazy-clips';
  initLazyClips();
</script>
