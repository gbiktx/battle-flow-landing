---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import StoreButtons from './StoreButtons.astro';

interface Props {
  placement?: string;
  trackImpression?: boolean;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { placement = 'footer', trackImpression = false } = Astro.props;
---

<section class="py-24 bg-black/40 border-y border-white/10">
  <div class="container mx-auto px-6 text-center">
    <h3 class="text-3xl md:text-5xl font-black text-white mb-12 tracking-tighter uppercase">
      {t('cta.title')}
    </h3>
    <StoreButtons placement={placement} size="large" trackImpression={trackImpression} />
  </div>
</section>
