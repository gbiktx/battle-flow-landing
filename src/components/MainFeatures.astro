---
import { getLangFromUrl, localizedPath, useTranslations } from '../i18n/utils';
import { contentLang } from '../i18n/content-lang';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const featuresDir = `/assets/images/features/${contentLang(lang)}`;

const mainFeatures = [
  {
    title: t('features.scan_title'),
    desc: t('features.scan_desc'),
    image: `${featuresDir}/scan.webp`,
    alt: 'BattleFlow instant IV scan notification reading a Pokémon’s IVs, CP, and best league',
    reversed: false
  },
  {
    title: t('features.manage_title'),
    desc: t('features.manage_desc'),
    image: `${featuresDir}/collection.webp`,
    alt: 'BattleFlow Pokémon collection screen showing a grid of the trainer’s stored Pokémon',
    reversed: true
  },
  {
    title: t('features.team_gen_title'),
    desc: t('features.team_gen_desc'),
    image: `${featuresDir}/build.webp`,
    alt: 'BattleFlow team score details rating a Pokémon GO PvP team on threat control, coverage, recovery, and consistency',
    reversed: false,
    // Descriptive anchor text: this is the homepage's only internal link to the
    // Team Builder landing page, so it should carry the query it ranks for.
    href: localizedPath(lang, '/team-builder/'),
    linkLabel: t('nav.team_builder')
  },
  {
    title: t('features.sim_title'),
    desc: t('features.sim_desc'),
    image: `${featuresDir}/simulate.webp`,
    alt: 'BattleFlow battle simulator showing a turn-by-turn Pokémon GO PvP matchup result',
    reversed: true
  },
  {
    title: t('features.drill_title'),
    desc: t('features.drill_desc'),
    image: `${featuresDir}/drill.webp`,
    alt: 'BattleFlow flashcards drilling Pokémon GO PvP matchups and move counts',
    reversed: false
  },
  {
    title: t('features.meta_title'),
    desc: t('features.meta_desc'),
    image: `${featuresDir}/scout.webp`,
    alt: 'BattleFlow local meta analysis charting ELO progression and the most common teams faced in Go Battle League',
    reversed: true
  }
];
---

<section class="py-24 bg-brand-dark/30">
  <div class="container mx-auto px-6">
    <div class="space-y-16 md:space-y-24">
      {mainFeatures.map((f, i) => (
        <>
          <div class={`flex flex-col ${f.reversed ? 'md:flex-row-reverse' : 'md:flex-row'} items-center gap-12 md:gap-24`}>
            <!-- Text Content -->
            <div class="flex-1 text-center md:text-left">
              <h2 class="text-3xl md:text-5xl mb-6 leading-tight">{f.title}</h2>
              <p class="text-lg text-gray-400 leading-relaxed mb-8">
                {f.desc}
              </p>
              {f.href && (
                <a href={f.href} class="inline-flex items-center gap-2 text-sm font-black uppercase tracking-widest text-brand-accent hover:text-white transition-colors">
                  {f.linkLabel} <span aria-hidden="true">→</span>
                </a>
              )}
            </div>

            <!-- Screenshot Visual -->
            <div class="flex-1 w-full max-w-[320px] mx-auto">
              <div class="relative aspect-[9/19.5] rounded-[3rem] overflow-hidden glass card-shadow border-8 border-brand-dark/50">
                <img
                  src={f.image}
                  alt={f.alt}
                  width="320"
                  height="693"
                  class="w-full h-full object-cover"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </div>
          </div>

          {/* Connector arrow: links the Scan → Manage → Build journey.
              Sweeps diagonally toward the next block's phone (i=0 right→left; i=1 mirrored left→right). */}
          {i < 2 && (
            <div class="flex justify-center -my-6 md:-my-10 text-brand-blue/70" aria-hidden="true">
              <svg viewBox="0 0 200 150" fill="none" stroke="currentColor" class={`w-44 md:w-60 h-auto ${i === 1 ? 'scale-x-[-1]' : ''}`}>
                {/* single arc swoosh with a subtle inked double-stroke */}
                <path d="M172 24 C 170 72, 142 108, 56 118" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M174 28 C 172 74, 145 111, 60 121" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.4" />
                {/* hand-drawn arrowhead following the arc's tangent (points down-left) */}
                <path d="M78 100 L56 118" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M82 128 L56 118" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </div>
          )}
        </>
      ))}
    </div>
  </div>
</section>
