---
import { getLangFromUrl, localizedPath, useTranslations } from '../i18n/utils';
import { getMoveCountsFaqs } from '../lib/faqs';
import { DRILL_LEAGUE_IDS, drillLeagues } from '../lib/drill-data';
import { moveKey, pokemonKey } from '../lib/game-data';
import { poolMoves, poolSpecies } from '../lib/move-pools-data';
import { getMoveTranslations, getPokemonTranslations, pickTranslations } from '../lib/translation-slices';
import DownloadButtons from './DownloadButtons.astro';
import MoveCountDrill from './MoveCountDrill';
import MoveCountLookup from './MoveCountLookup';
import MoveCountsChart from './MoveCountsChart.astro';
import StoreButtons from './StoreButtons.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const faqs = getMoveCountsFaqs(t);

// Both islands render localized species *and* move names, but they need
// different slices of the dictionary — and island props are serialized into the
// page HTML, so handing each the full 1,740-species map shipped ~110 KB of
// markup twice. Narrow each to the ids it can actually display.
const pokemonNames = getPokemonTranslations(lang);
const moveNames = getMoveTranslations(lang);

// The drill only ever names its ~90 deck species; the lookup can name any of
// the ~1,120 searchable ones.
const drillSpecies = DRILL_LEAGUE_IDS.flatMap((id) => drillLeagues[id]?.species ?? []);
const drillPokemonKeys = drillSpecies.map((s) => pokemonKey(s.id));
const drillMoveKeys = drillSpecies.flatMap((s) => [...s.moveset, ...s.fastPool, ...s.chargedPool]).map(moveKey);

const drillPokemonTranslations = pickTranslations(pokemonNames, drillPokemonKeys);
const drillMoveTranslations = pickTranslations(moveNames, drillMoveKeys);
const lookupPokemonTranslations = pickTranslations(pokemonNames, poolSpecies.map((s) => pokemonKey(s.id)));
const lookupMoveTranslations = pickTranslations(moveNames, Object.keys(poolMoves).map(moveKey));

const href = (path: string) => localizedPath(lang, path);
---

<main class="overflow-hidden">
  <section class="relative pt-36 pb-16">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_70%_30%,rgba(3,147,218,0.16),transparent_45%)]" aria-hidden="true"></div>
    <div class="container relative mx-auto px-6">
      <div class="max-w-3xl">
        <p class="inline-block mb-6 rounded-full border border-brand-accent/25 bg-brand-accent/10 px-4 py-2 text-xs font-black uppercase tracking-[0.2em] text-brand-accent">
          {t('drill.eyebrow')}
        </p>
        <h1 class="leading-[0.92] text-glow">
          <span class="block text-4xl sm:text-5xl lg:text-6xl">{t('drill.meta_title')}</span>
          <span class="block mt-5 text-2xl sm:text-3xl lg:text-4xl gradient-text italic">{t('drill.title')}</span>
        </h1>
        <p class="mt-8 text-lg sm:text-xl leading-relaxed text-gray-300">
          {t('drill.subtitle')}
        </p>
        <div class="mt-9">
          <StoreButtons placement="move-counts-hero" align="lg-start" trackImpression />
        </div>
      </div>
    </div>
  </section>

  <section class="pb-16">
    <MoveCountLookup
      client:load
      lang={lang}
      pokemonTranslations={lookupPokemonTranslations}
      moveTranslations={lookupMoveTranslations}
    />
  </section>

  <section class="pb-20">
    <MoveCountDrill
      client:load
      lang={lang}
      pokemonTranslations={drillPokemonTranslations}
      moveTranslations={drillMoveTranslations}
    />
  </section>

  <MoveCountsChart />

  <section class="py-24 bg-white/2 border-t border-white/10">
    <div class="container mx-auto px-6 max-w-4xl">
      <h2 class="mb-14 text-center text-3xl md:text-5xl">{t('faq.title')}</h2>
      <div class="space-y-4">
        {faqs.map(({ q, a }) => (
          <details class="group glass card-shadow rounded-2xl">
            <summary class="flex cursor-pointer list-none items-center justify-between p-6 text-lg font-bold md:p-8 md:text-xl">
              {q}
              <svg xmlns="http://www.w3.org/2000/svg" class="ml-4 h-5 w-5 flex-shrink-0 text-gray-400 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="px-6 pb-6 leading-relaxed text-gray-400 md:px-8 md:pb-8">{a}</div>
          </details>
        ))}
      </div>

      <p class="mt-12 text-center text-sm text-gray-500">
        <a href={href('/movedex/')} class="text-brand-accent hover:underline font-bold">{t('nav.movedex')}</a>
        <span class="mx-3 text-gray-700">·</span>
        <a href={href('/team-builder/')} class="text-brand-accent hover:underline font-bold">{t('nav.team_builder')}</a>
        <span class="mx-3 text-gray-700">·</span>
        <a href={href('/iv-calculator/')} class="text-brand-accent hover:underline font-bold">{t('nav.iv')}</a>
      </p>
    </div>
  </section>

  <DownloadButtons placement="move-counts-footer" />
</main>
