---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { DRILL_LEAGUE_IDS, LEAGUE_LABEL_KEYS, drillLeagues } from '../lib/drill-data';
import {
  getMoveName,
  getPokemonName,
  getSpritePath,
  TYPE_COLORS,
  hexToRgba,
  type Move,
  type Pokemon,
} from '../lib/game-data';
import { cadenceCounts, cadenceDifficulty, formatCadence } from '../lib/move-counts';
import { moves as movesData } from '../lib/moves-data';
import { pokemon as pokemonData } from '../lib/pokemon-data';
import { getMoveTranslations, getPokemonTranslations } from '../lib/translation-slices';

// The drill and the lookup are JavaScript islands — nothing in either is
// crawlable. This chart is the page's indexable body, and it's what the "fast
// move counting chart" query cluster is actually looking for. Rendered from the
// same decks the drill uses, so the reference and the quiz can never disagree.
//
// Laid out as one card per species, not as a table: most of this site's traffic
// is mobile, and a five-column table needs ~640px, which put the counts — the
// entire payload — off the right edge of a phone behind a horizontal scroll.

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const moveNames = getMoveTranslations(lang);
const pokemonNames = getPokemonTranslations(lang);

const moveById = new Map<string, Move>(movesData.map((m) => [m.id, m]));
const pokemonById = new Map<string, Pokemon>(pokemonData.map((p) => [p.id, p]));

interface ChargedRow {
  move: Move;
  cadence: number[];
  shifting: boolean;
}

interface SpeciesCard {
  id: string;
  name: string;
  sprite: string;
  fast: Move;
  charged: ChargedRow[];
}

const tables = DRILL_LEAGUE_IDS.map((id) => {
  const cards: SpeciesCard[] = [];
  for (const species of drillLeagues[id].species) {
    const [fastId, ...chargedIds] = species.moveset;
    const fast = moveById.get(fastId);
    const mon = pokemonById.get(species.id);
    if (!fast || !mon) continue;

    const charged: ChargedRow[] = [];
    for (const chargedId of chargedIds) {
      const move = moveById.get(chargedId);
      if (!move) continue;
      const cadence = cadenceCounts(move.energy, fast.energyGain);
      charged.push({ move, cadence, shifting: cadenceDifficulty(cadence) === 'shifting' });
    }
    if (!charged.length) continue;

    cards.push({
      id: species.id,
      name: getPokemonName(mon.id, mon.name, pokemonNames),
      sprite: getSpritePath(mon),
      fast,
      charged,
    });
  }
  return { id, label: t(LEAGUE_LABEL_KEYS[id]), cards };
});

const typeStyle = (move: Move) => {
  const color = TYPE_COLORS[move.type] ?? '#a3a49e';
  return `background-color:${hexToRgba(color, 0.14)};border-color:${hexToRgba(color, 0.35)};color:${color}`;
};
---

<section class="py-20 border-t border-white/10">
  <div class="container mx-auto px-6">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-3xl md:text-5xl font-black text-white tracking-tighter uppercase mb-4">
        {t('drill.chart_title')}
      </h2>
      <p class="text-gray-400 leading-relaxed mb-10 max-w-2xl">
        {t('drill.chart_intro')}
      </p>

      {tables.map((table, i) => (
        <details class="glass rounded-[2rem] border border-white/10 mb-4 group" open={i === 0} data-testid="counts-league" data-league={table.id}>
          <summary class="flex items-center justify-between cursor-pointer p-6 md:p-8 list-none">
            <span class="text-lg md:text-xl font-black text-white uppercase tracking-tight">{table.label}</span>
            <span class="flex items-center gap-4">
              <span class="text-[10px] font-black uppercase tracking-widest text-gray-500">
                {table.cards.length} {t('drill.chart_pokemon')}
              </span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 flex-shrink-0 text-gray-400 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </summary>

          <div class="px-4 pb-6 md:px-8 md:pb-8">
            <p class="text-[10px] font-black uppercase tracking-widest text-gray-500 mb-4">
              {t('drill.chart_legend')}
            </p>

            <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
              {table.cards.map((card) => (
                <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-4">
                  <div class="flex items-center gap-3 mb-3">
                    <img src={card.sprite} alt="" width="40" height="40" loading="lazy" class="w-10 h-10 object-contain flex-shrink-0" />
                    <div class="min-w-0">
                      <p class="font-black text-white leading-tight truncate">{card.name}</p>
                      <span class="mt-1 inline-block px-2 py-0.5 rounded-md text-[11px] font-bold border" style={typeStyle(card.fast)}>
                        {getMoveName(card.fast.id, card.fast.name, moveNames)}
                      </span>
                    </div>
                  </div>

                  <ul class="space-y-2">
                    {card.charged.map((row) => (
                      <li
                        class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1 border-t border-white/5 pt-2"
                        data-testid="counts-row"
                        data-species={card.id}
                        data-charged={row.move.id}
                      >
                        <span class="flex items-baseline gap-2 min-w-0">
                          <span class="inline-block px-2 py-0.5 rounded-md text-[11px] font-bold border truncate" style={typeStyle(row.move)}>
                            {getMoveName(row.move.id, row.move.name, moveNames)}
                          </span>
                          <span class="text-[11px] font-bold text-gray-500 tabular-nums flex-shrink-0">{row.move.energy}e</span>
                        </span>
                        <span
                          data-testid="counts-cadence"
                          class={`text-sm font-black tabular-nums whitespace-nowrap ${row.shifting ? 'text-brand-accent' : 'text-white'}`}
                        >
                          {formatCadence(row.cadence)}
                        </span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>

            <p class="text-xs text-gray-500 mt-6 leading-relaxed">{t('drill.chart_note')}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
