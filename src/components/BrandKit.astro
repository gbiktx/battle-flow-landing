const text = brandTranslations[lang] || brandTranslations.en;

// Core Brand Guidelines Data
const brandColors = [
  { name: 'Indigo Deep (Background)', hex: '#0B0E1A', usage: 'Main application and website body background. Ensures premium dark-mode contrast.' },
  { name: 'Brand Navy (Panels)', hex: '#1A2035', usage: 'Card components, tables, navigation backgrounds, and structural borders.' },
  { name: 'Brand Blue (Primary)', hex: '#505B92', usage: 'Primary buttons, active indicators, and secondary title highlights.' },
  { name: 'Brand Accent (Cyan)', hex: '#0393DA', usage: 'Glow text shadows, gradient endpoints, Call to Actions, and performance metrics.' },
  { name: 'Light White (Text)', hex: '#FFFFFF', usage: 'Primary headlines, crucial values, and high-readability paragraph text.' },
];

const logos = [
  { name: 'App Icon (PNG)', path: '/assets/images/appicon.png', size: '860 KB', dimensions: '1024x1024 px' },
  { name: 'Rounded Logo (PNG)', path: '/assets/images/current_logo_rounded.png', size: '851 KB', dimensions: '1024x1024 px' },
  { name: 'Large Brand Logo (PNG)', path: '/assets/images/large-logo.png', size: '860 KB', dimensions: '1024x1024 px' },
  { name: 'iOS App Icon (SVG)', path: '/assets/images/ios.svg', size: '11 KB', dimensions: 'Vector' },
];

const socialGraphics = [
  { name: 'Twitter/X & LinkedIn Banner (16:9)', path: '/assets/images/brand/battleflow_social_banner.jpg', type: 'JPG Background', size: 'High-Res' },
  { name: 'Instagram & Feed Square Template (1:1)', path: '/assets/images/brand/battleflow_social_post.jpg', type: 'JPG Layout', size: 'High-Res' },
];

const screenshots = [
  { name: 'App Screenshot 1 - Dashboard', path: `/assets/images/screenshots/${lang === 'en' ? '' : lang + '/'}1.png` },
  { name: 'App Screenshot 2 - Team Generator', path: `/assets/images/screenshots/${lang === 'en' ? '' : lang + '/'}2.png` },
  { name: 'App Screenshot 3 - Simulator', path: `/assets/images/screenshots/${lang === 'en' ? '' : lang + '/'}3.png` },
  { name: 'App Screenshot 4 - IV Checker', path: `/assets/images/screenshots/${lang === 'en' ? '' : lang + '/'}4.png` },
  { name: 'App Screenshot 5 - MoveDex', path: `/assets/images/screenshots/${lang === 'en' ? '' : lang + '/'}5.png` },
  { name: 'App Screenshot 6 - GBL Meta', path: `/assets/images/screenshots/${lang === 'en' ? '' : lang + '/'}6.png` },
];

const videoPreviews = [
  { name: 'IV Checker Clip (MP4)', path: '/assets/images/IVChecker-Preview.mp4', desc: 'Short screen recording demonstrating search and slider metrics.' },
  { name: 'Simulator Clip (MP4)', path: '/assets/images/Simulator-Preview.mp4', desc: 'Step-by-step combat logs and timelines animation.' },
  { name: 'Team Generator Clip (MP4)', path: '/assets/images/Team-Generator-Preview.mp4', desc: 'Generating teams instantly from local box inventory.' },
];

const swipePosts = [
  {
    title: '📢 Launch Announcement (X / Twitter)',
    content: `🔥 Pokémon GO trainers! Building competitive Great & Ultra League teams just got easier.

Meet BattleFlow: a high-performance PvP team builder that works 100% OFFLINE. 

⚡ Generates optimal squads directly from YOUR own collection.
📊 Instant simulation timelines.
📈 Local meta tracker.

Download free on iOS & Android: https://battleflow.app

#PokemonGO #GoBattleLeague #GBL #PokemonGOPvP`
  },
  {
    title: '🤝 Developer Story (LinkedIn)',
    content: `I am excited to share BattleFlow—a mobile app built specifically for competitive Pokémon GO PvP trainers.

Unlike traditional list-based meta sites, BattleFlow runs a custom matching engine locally. You enter your existing Pokémon collection, and it dynamically suggests synergized teams based on coverage, stability, and threat indexes.

Key Achievements:
✅ 100% Offline-First architecture (works in the middle of tournaments or remote parks)
✅ Highly responsive simulation engine powered by PvPoke algorithms
✅ Local meta-logging to track your specific GBL rank lead trends

Built with React Native and Astro for the web landing suite, optimized for speed. Free to download on both App Store and Play Store.

#MobileApp #ReactNative #PokemonGO #AppLaunch #MobileDevelopment #GamingTech`
  },
  {
    title: '🎮 Community Spotlight (Discord / Reddit)',
    content: `Hey Trainers! Just launched BattleFlow, a free PvP Companion App.

Tired of copying "meta teams" from a web list only to realize you're missing the XL candies or the legacy moves? BattleFlow solves this. Add the PvP candidates you actually have in your bag to your in-app box, and the generator will output ready-to-run teams customized to your inventory.

Includes:
- Matchup simulator with turn-by-turn timelines, custom shield/energy leads.
- Offline-first PvP IV calculator with level cap options (XL Candy/Buddy level 40/50/51).
- Local meta logger so you can record your sets and see what leads/closers you face the most.

It's completely free, no ads, no paywalls. Grab it here:
iOS App Store: https://apps.apple.com/us/app/battleflow/id6738843812
Google Play Store: https://play.google.com/store/apps/details?id=com.baru.software.oak

Would love to hear your feedback on team synergies!`
  }
];
---

<!-- Hero Banner -->
<div class="relative overflow-hidden pt-28 pb-16 bg-[#0B0E1A]">
  <!-- Abstract cyber background -->
  <div class="absolute inset-0 opacity-20 pointer-events-none bg-cover bg-center" style="background-image: url('/assets/images/brand/battleflow_social_banner.jpg')"></div>
  <div class="absolute inset-0 bg-gradient-to-b from-transparent to-[#0B0E1A] pointer-events-none"></div>

  <div class="container mx-auto px-6 relative z-10">
    <div class="max-w-4xl">
      <span class="inline-block bg-brand-accent/15 text-brand-accent px-4 py-1.5 rounded-full text-xs font-black uppercase tracking-[0.25em] mb-6 border border-brand-accent/30 text-glow">
        MEDIA & ASSET CENTER
      </span>
      <h1 class="text-4xl md:text-6xl lg:text-7xl font-black tracking-[-0.05em] text-white leading-none uppercase mb-6">
        {text.title}
      </h1>
      <p class="text-xl md:text-2xl text-gray-400 font-medium leading-relaxed max-w-3xl">
        {text.subtitle}
      </p>
    </div>
  </div>
</div>

<div class="container mx-auto px-6 py-12">
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
    
    <!-- Left Sidebar: Brand Identity Quick Overview -->
    <div class="lg:col-span-1 space-y-8">
      <div class="glass rounded-3xl p-8 border border-white/10 card-shadow">
        <h3 class="text-2xl font-black text-white uppercase tracking-tight mb-4">{text.intro_title}</h3>
        <p class="text-gray-400 text-sm leading-relaxed mb-6">
          {text.intro_body}
        </p>
        <div class="border-t border-white/10 pt-6 space-y-4">
          <div class="flex justify-between items-center text-xs">
            <span class="text-gray-500 font-bold uppercase tracking-wider">Developer</span>
            <span class="text-white font-bold">Baru Software Co</span>
          </div>
          <div class="flex justify-between items-center text-xs">
            <span class="text-gray-500 font-bold uppercase tracking-wider">Framework</span>
            <span class="text-white font-bold">Astro & React</span>
          </div>
          <div class="flex justify-between items-center text-xs">
            <span class="text-gray-500 font-bold uppercase tracking-wider">Platforms</span>
            <span class="text-brand-accent font-bold uppercase">iOS & Android</span>
          </div>
          <div class="flex justify-between items-center text-xs">
            <span class="text-gray-500 font-bold uppercase tracking-wider">Tech Aesthetic</span>
            <span class="text-white font-bold">Performance-First PvP</span>
          </div>
        </div>
      </div>

      <!-- App Features Quick Metrics -->
      <div class="glass rounded-3xl p-8 border border-white/10 card-shadow bg-linear-to-b from-[#1A2035]/30 to-transparent">
        <h3 class="text-xl font-black text-white uppercase tracking-tight mb-6">{text.features_title}</h3>
        <div class="space-y-6">
          <div class="flex items-start gap-4">
            <div class="w-8 h-8 rounded-lg bg-brand-accent/20 flex items-center justify-center text-brand-accent font-black text-sm shrink-0">1</div>
            <div>
              <h4 class="text-sm font-bold text-white uppercase">Personalized Team Gen</h4>
              <p class="text-xs text-gray-500 mt-1">Generates custom GBL squads based on the player's unique box, not a standard preset list.</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="w-8 h-8 rounded-lg bg-brand-accent/20 flex items-center justify-center text-brand-accent font-black text-sm shrink-0">2</div>
            <div>
              <h4 class="text-sm font-bold text-white uppercase">Combat Simulation Timelines</h4>
              <p class="text-xs text-gray-500 mt-1">Provides turn-by-turn energy and damage metrics to simulate battle endings offline.</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="w-8 h-8 rounded-lg bg-brand-accent/20 flex items-center justify-center text-brand-accent font-black text-sm shrink-0">3</div>
            <div>
              <h4 class="text-sm font-bold text-white uppercase">Offline-First Engine</h4>
              <p class="text-xs text-gray-500 mt-1">Works fully offline so players can optimize their teams anywhere during tournaments.</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Content: The Media Kit Assets -->
    <div class="lg:col-span-2 space-y-16">

      <!-- Section: Logos & Icons -->
      <section class="space-y-6">
        <h2 class="text-3xl font-black text-white uppercase tracking-tight border-b border-white/10 pb-4 flex items-center gap-3">
          <svg class="w-6 h-6 text-brand-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          {text.section_logos}
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {logos.map((logo) => (
            <div class="glass rounded-2xl p-6 border border-white/5 flex items-center justify-between group hover:border-white/20 transition-all bg-black/20">
              <div class="flex items-center gap-4">
                <div class="w-16 h-16 rounded-xl bg-[#0B0E1A] border border-white/10 flex items-center justify-center p-2 group-hover:scale-105 transition-transform overflow-hidden shrink-0">
                  <img src={logo.path} alt={logo.name} class="max-w-full max-h-full object-contain" />
                </div>
                <div>
                  <h4 class="font-bold text-white uppercase text-sm tracking-tight">{logo.name}</h4>
                  <p class="text-xs text-gray-500 mt-0.5">{logo.dimensions} • {logo.size}</p>
                </div>
              </div>
              <a href={logo.path} download class="p-3 bg-white/5 hover:bg-brand-accent hover:text-white text-gray-400 rounded-xl transition-all" title={text.download_btn} aria-label={text.download_btn}>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
              </a>
            </div>
          ))}
        </div>
      </section>

      <!-- Section: Colors -->
      <section class="space-y-6">
        <h2 class="text-3xl font-black text-white uppercase tracking-tight border-b border-white/10 pb-4 flex items-center gap-3">
          <svg class="w-6 h-6 text-brand-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/></svg>
          {text.section_colors}
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {brandColors.map((color) => (
            <div class="glass rounded-2xl p-6 border border-white/5 flex flex-col justify-between bg-black/20">
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-xl shrink-0 border border-white/10 shadow-lg" style={`background-color: ${color.hex}`}></div>
                <div>
                  <h4 class="font-bold text-white uppercase text-sm tracking-tight">{color.name}</h4>
                  <p class="text-xs text-gray-500 mt-1 leading-relaxed">{color.usage}</p>
                </div>
              </div>
              <div class="mt-4 pt-4 border-t border-white/5 flex items-center justify-between">
                <code class="text-brand-accent text-xs font-black tracking-wider">{color.hex}</code>
                <button class="copy-hex-btn text-xs font-bold uppercase tracking-widest text-gray-400 hover:text-white transition-colors flex items-center gap-2" data-hex={color.hex}>
