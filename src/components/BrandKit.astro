<!-- Toast notification popup for copies -->
<div id="copy-toast" class="fixed bottom-6 right-6 glass border border-brand-accent/50 px-6 py-3 rounded-xl text-white font-bold uppercase tracking-widest text-xs translate-y-20 opacity-0 transition-all duration-300 z-50 flex items-center gap-3">
  <div class="w-2.5 h-2.5 rounded-full bg-brand-accent animate-ping"></div>
  <span id="toast-message">{text.copied_text}</span>
</div>

<script>
  // Hex Copier
  const hexButtons = document.querySelectorAll('.copy-hex-btn');
  const textButtons = document.querySelectorAll('.copy-text-btn');
  const toast = document.getElementById('copy-toast');
  const toastMsg = document.getElementById('toast-message');

  function showToast(message: string) {
    if (!toast || !toastMsg) return;
    toastMsg.textContent = message;
    toast.classList.remove('translate-y-20', 'opacity-0');
    toast.classList.add('translate-y-0', 'opacity-100');

    setTimeout(() => {
      toast.classList.remove('translate-y-0', 'opacity-100');
      toast.classList.add('translate-y-20', 'opacity-0');
    }, 2500);
  }

  hexButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const hex = btn.getAttribute('data-hex');
      if (hex) {
        navigator.clipboard?.writeText(hex).then(() => {
          showToast(`Copied ${hex} to Clipboard!`);
        }).catch(() => showToast('Copy failed — select the value and copy manually'));
      }
    });
  });

  textButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const content = btn.getAttribute('data-content');
      if (content) {
        navigator.clipboard?.writeText(content).then(() => {
          showToast('Text copied to Clipboard!');
        }).catch(() => showToast('Copy failed — select the text and copy manually'));
      }
    });
  });
</script>
