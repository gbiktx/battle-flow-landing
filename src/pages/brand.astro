---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import BrandKit from '../components/BrandKit.astro';
import DownloadButtons from '../components/DownloadButtons.astro';
import { useTranslations } from '../i18n/utils';
import { buildFeaturePageSchemas } from '../lib/seo-schemas';

const lang = 'en';
const t = useTranslations(lang);

// Local translations mapping since they are in BrandKit.astro
const metaTitle = 'BattleFlow Media Kit | Brand Assets & Press Materials';
const metaDesc = 'Download official logos, colors, screenshots, social graphics, and pre-written copy for BattleFlow—the Pokémon GO PvP team builder.';

const jsonLd = buildFeaturePageSchemas({
  siteUrl: Astro.site!,
  lang,
  pagePath: '/brand/',
  name: metaTitle,
  description: metaDesc,
  navCrumbName: 'Brand Kit',
});
---

<Layout
  title={metaTitle}
  description={metaDesc}
  jsonLd={jsonLd}
>
	<Nav />
	<main>
		<BrandKit />
	</main>
	<DownloadButtons />
	<Footer />
</Layout>
