---
import { languages } from '../../i18n/ui';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import BrandKit from '../../components/BrandKit.astro';
import DownloadButtons from '../../components/DownloadButtons.astro';
import { getLangFromUrl } from '../../i18n/utils';
import { buildFeaturePageSchemas } from '../../lib/seo-schemas';

export function getStaticPaths() {
  return Object.keys(languages)
    .filter(lang => lang !== 'en')
    .map((lang) => ({ params: { lang } }));
}

const lang = getLangFromUrl(Astro.url);

const metaTranslations = {
  es: {
    title: 'Kit de Prensa de BattleFlow | Recursos de Marca',
    desc: 'Descarga logos oficiales, colores, capturas, gráficos y textos listos para compartir de BattleFlow—el creador de equipos PvP de Pokémon GO.',
  },
  fr: {
    title: 'Kit Média BattleFlow | Ressources de Marque',
    desc: 'Téléchargez les logos officiels, couleurs, captures d\'écran, visuels et textes pour BattleFlow.',
  },
  de: {
    title: 'BattleFlow Media Kit | Brand Assets & Presse',
    desc: 'Lade offizielle Logos, Screenshots, Farbcodes und Social-Media-Assets für BattleFlow herunter.',
  },
  it: {
    title: 'Media Kit BattleFlow | Risorse per i Media',
    desc: 'Scarica loghi ufficiali, colori, screenshot e testi pronti per BattleFlow.',
  },
  pt: {
    title: 'Kit de Imprensa do BattleFlow | Recursos de Marca',
    desc: 'Baixe logotipos oficiais, paletas de cores, capturas de tela e materiais promocionais do BattleFlow.',
  },
  ja: {
    title: 'BattleFlow メディアキット | ブランドアセット・プレスキット',
    desc: 'ポケモンGO PvPチームビルダー「BattleFlow」の公式ロゴ、カラー、スクリーンショット、SNS画像をダウンロード。',
  },
  ko: {
    title: 'BattleFlow 미디어 키트 | 브랜드 리소스 및 보도 자료',
    desc: '포켓몬 GO PvP 팀 빌더 BattleFlow의 공식 로고, 브랜드 컬러, 스크린샷, SNS 애셋을 다운로드하세요.',
  },
  'zh-Hant': {
    title: 'BattleFlow 媒體資源套件 | 官方品牌識別資產',
    desc: '下載 BattleFlow 官方 Logo、品牌色彩、系統截圖、社群橫幅及預撰文案，寶可夢 GO PvP 隊伍產生器。',
  }
};

const t = metaTranslations[lang] || {
  title: 'BattleFlow Media Kit | Brand Assets & Press Materials',
  desc: 'Download official logos, colors, screenshots, social graphics, and pre-written copy for BattleFlow—the Pokémon GO PvP team builder.',
};

const jsonLd = buildFeaturePageSchemas({
  siteUrl: Astro.site!,
  lang,
  pagePath: `/${lang}/brand/`,
  name: t.title,
  description: t.desc,
  navCrumbName: 'Brand Kit',
});
---

<Layout
  title={t.title}
  description={t.desc}
  jsonLd={jsonLd}
>
	<Nav />
	<main>
		<BrandKit />
	</main>
	<DownloadButtons />
	<Footer />
</Layout>
