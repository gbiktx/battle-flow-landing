---
// Localized embed target for the app's in-app WebView. See ../gbl-calendar.astro
// for why this does not use Layout.astro.
import '../../../styles/global.css';
import GblCalendar from '../../../components/GblCalendar';
import { languages } from '../../../i18n/ui';
import { useTranslations, toBcp47 } from '../../../i18n/utils';

export function getStaticPaths() {
  return Object.keys(languages)
    .filter((lang) => lang !== 'en')
    .map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = useTranslations(lang as keyof typeof languages);
---

<html lang={toBcp47(lang!)}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="robots" content="noindex" />
		<title>{t('gbl.title')}</title>
		<style is:global>
			body { background: transparent; overscroll-behavior-y: none; }
		</style>
	</head>
	<body class="bg-brand-dark text-white">
		<main class="py-4">
			<GblCalendar client:load lang={lang!} embed={true} />
		</main>
	</body>
</html>
