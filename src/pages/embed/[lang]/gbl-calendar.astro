---
// Localized embed target for the app's in-app WebView. See ../gbl-calendar.astro
// for why this does not use Layout.astro.
import '../../../styles/global.css';
import GblCalendar from '../../../components/GblCalendar';
import { languages } from '../../../i18n/ui';
import { useTranslations, toBcp47 } from '../../../i18n/utils';

export function getStaticPaths() {
  return Object.keys(languages)
    .filter((lang) => lang !== 'en')
    .map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = useTranslations(lang as keyof typeof languages);
---

<html lang={toBcp47(lang!)}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="robots" content="noindex" />
		<title>{t('gbl.title')}</title>
		<style is:global>
			/* The calendar ships dark in every host, so the page paints its own
			   ground rather than letting the app's show through. The WebView is
			   transparent (gbl_calendar_page.dart) and the app's scaffold follows
			   the app's theme — on a light one, this list's white-on-dark palette
			   was white-on-white. Opaque here is what makes it readable, and it
			   keeps the site's one look: the landing pages are dark-only too. */
			body { background: #0B0E1A; overscroll-behavior-y: none; }
		</style>
	</head>
	<body class="text-white">
		<main class="py-4">
			<GblCalendar client:load lang={lang!} embed={true} />
		</main>
	</body>
</html>
