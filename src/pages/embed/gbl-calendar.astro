---
// Embed target for the BattleFlow app's in-app WebView.
//
// The app dropped its native GBL calendar (it was compiled in, so a new season
// needed an app release). This page is now the single source of the schedule for
// both web and app — deploying the site updates every installed client.
//
// Deliberately NOT built on Layout.astro: no Nav, no Footer, no download CTAs,
// no Mixpanel (in-app traffic would otherwise land in the site's web analytics),
// no OG/canonical tags. Just the calendar on the app's own ground.
//
// Cup rows render as `battleflow://cup/{cpLimit}-{cupName}` links, which the app
// intercepts in NavigationDelegate.onNavigationRequest to switch the active cup.
import '../../styles/global.css';
import GblCalendar from '../../components/GblCalendar';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations('en');
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="robots" content="noindex" />
		<title>{t('gbl.title')}</title>
		<style is:global>
			/* The calendar ships dark in every host, so the page paints its own
			   ground rather than letting the app's show through. The WebView is
			   transparent (gbl_calendar_page.dart) and the app's scaffold follows
			   the app's theme — on a light one, this list's white-on-dark palette
			   was white-on-white. Opaque here is what makes it readable, and it
			   keeps the site's one look: the landing pages are dark-only too. */
			body { background: #0B0E1A; overscroll-behavior-y: none; }
		</style>
	</head>
	<body class="text-white">
		<main class="py-4">
			<GblCalendar client:load lang="en" embed={true} />
		</main>
	</body>
</html>
