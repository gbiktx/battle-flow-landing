---
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import TeamBuilder from '../components/TeamBuilder.astro';
import { useTranslations } from '../i18n/utils';
import Layout from '../layouts/Layout.astro';
import { getTeamBuilderFaqs } from '../lib/faqs';
import { buildFAQSchema, buildMobileAppSchemas } from '../lib/seo-schemas';

const lang = 'en';
const t = useTranslations(lang);
const questions = getTeamBuilderFaqs(t);
const jsonLd = [
  ...buildMobileAppSchemas({
    siteUrl: Astro.site!,
    lang,
    pagePath: '/team-builder/',
    description: t('team.meta_description'),
    navCrumbName: t('nav.team_builder'),
    featureList: [t('team.step1_desc'), t('team.scores_intro'), t('team.collection_desc')],
  }),
  buildFAQSchema({ questions }),
];
---

<Layout title={t('team.meta_title')} description={t('team.meta_description')} jsonLd={jsonLd} preloadImage="/assets/images/features/en/build.webp">
  <Nav />
  <TeamBuilder />
  <Footer />
</Layout>
